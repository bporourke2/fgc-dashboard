# Settings for docker-compose.yml. Copy to .env next to it.
# This is NOT the claimer's .env. The dashboard never needs your store credentials.

# Docker volume holding the claimer's /fgc/data (find it with: docker volume ls | grep fgc_data)
FGC_VOLUME=fgc_fgc_data

# Name of the claimer container (FGC-R's compose file uses "fgc-remaster")
FGC_CONTAINER=fgc-remaster

# Port on the host for the dashboard
DASHBOARD_PORT=8080

# Optional basic auth. Turned on only when both are set.
DASHBOARD_USER=
DASHBOARD_PASS=

# Show Prime Gaming redemption codes in the UI (click to reveal)
DASHBOARD_SHOW_CODES=false
